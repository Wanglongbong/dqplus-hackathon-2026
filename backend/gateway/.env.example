PORT=3000
HOST=0.0.0.0
# Comma-separated list of allowed CORS origins.
# Defaults to dqplus.ddns.net and localhost (any scheme/port).
# CORS_ORIGIN=http://dqplus.ddns.net,http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=dealflow
DB_USER=dqplus
DB_PASSWORD=dqplus-local-development-only
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=dqplus-local-jwt-secret-change-before-production
JWT_EXPIRES_IN=1d

EXTRACT_SERVICE_URL=http://localhost:3001
MATCH_SERVICE_URL=http://localhost:3002
INTERNAL_SERVICE_TOKEN=dqplus-local-service-token-change-me
INTERNAL_REQUEST_TIMEOUT_MS=12000
CONNECTION_DAILY_LIMIT=5
# Comma-separated moderator accounts. Leave empty for no admin access.
ADMIN_EMAILS=
PUBLIC_WEB_URL=http://localhost:5173
# Use payos in production. mock is refused when NODE_ENV=production.
PAYMENT_PROVIDER=mock
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
GOOGLE_PLACES_API_KEY=
SOURCE_REFRESH_INTERVAL_MS=86400000
SOURCE_REFRESH_BATCH_SIZE=50
